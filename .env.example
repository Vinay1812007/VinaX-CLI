# Copy to .env (never commit .env). Environment variables override keys stored with `vinax config set-key`.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# NVIDIA (build.nvidia.com); use it with: vinax --model NVD_CHAT_OSS_20_B
NVIDIA_API_KEY=

# Optional: a VinaX gateway token (instead of `vinax login --gateway`)
# VINAX_GATEWAY_TOKEN=

# Optional
# VINAX_HOME=~/.vinax            # relocate VinaX's user state
# VINAX_SECRETS_BACKEND=file     # skip the OS keychain

# ---- apps/gateway (set these in Render's dashboard, not here) ----
# GROQ_API_KEY / OPENROUTER_API_KEY / NVIDIA_API_KEY   provider keys the gateway uses
# NVIDIA_BASE_URL=...                 optional: a self-hosted NIM instead of NVIDIA's hosted API
# VINAX_TOKEN_HASHES=alice:<sha256>   create entries with: pnpm gateway:token <name>
# RATE_LIMIT_RPM=20
# RATE_LIMIT_RPD=500
# MAX_BODY_BYTES=8000000
# DEFAULT_MODELS=groq:openai/gpt-oss-120b,openrouter:qwen/qwen3.8-27b:free
