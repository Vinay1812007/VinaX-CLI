{
  "name": "@vinax/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Optional VinaX gateway: relays OpenAI-compatible chat completions to Groq and OpenRouter with shared keys.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "create-token": "tsx src/token.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@vinax/testkit": "workspace:*",
    "tsup": "^8.5.1"
  }
}
