{
  "name": "vinax-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "vinax": "tsx packages/cli/src/bin.ts",
    "release": "pnpm build && changeset publish",
    "build:binaries": "bun scripts/build-binaries.ts",
    "gateway:token": "pnpm --filter @vinax/gateway run create-token",
    "gateway:dev": "pnpm --filter @vinax/gateway run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  }
}
