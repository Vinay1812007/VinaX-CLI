{
  "name": "vinax",
  "version": "0.0.0",
  "description": "VinaX: an agentic coding assistant for your terminal, powered by free-tier LLMs.",
  "type": "module",
  "license": "MIT",
  "author": "Vinay1812007",
  "homepage": "https://github.com/Vinay1812007/VinaX-CLI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vinay1812007/VinaX-CLI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Vinay1812007/VinaX-CLI/issues"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "coding-assistant",
    "terminal",
    "groq",
    "openrouter",
    "llm"
  ],
  "bin": {
    "vinax": "dist/vinax.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.1.0",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.9",
    "ink": "^7.1.1",
    "marked": "^18.0.14",
    "openai": "^7.21.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "string-width": "^8.2.2",
    "turndown": "^7.2.4",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vinax/core": "workspace:*",
    "@vinax/testkit": "workspace:*",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
